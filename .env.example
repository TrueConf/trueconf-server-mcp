# TrueConf Server MCP — example configuration.
# Copy to .env and edit. .env is git-ignored.
#
# Priority (highest → lowest):
#   1. CLI flags:  trueconf-server-mcp --server 10.0.0.1 --port 9000
#   2. Environment variables (export TRUECONF_SERVER=...)
#   3. This .env file (loaded via python-dotenv)
#   4. Built-in defaults
#
# Required:
TRUECONF_SERVER=10.140.1.255
TRUECONF_CLIENT_ID=your_client_id
TRUECONF_SECRET=your_secret
#
# Optional:
TRUECONF_VERIFY_SSL=false
MCP_BASE_URL=https://localhost
# MCP_BASE_URL must be reachable by MCP clients from outside — 127.0.0.1 does NOT work.
# Default: https://localhost (port 443 omitted); http://localhost:<port> when MCP_NO_TLS=true.
# For LAN access use https://<your-LAN-IP>, e.g. https://10.140.1.177
TRUECONF_MCP_PORT=443
# Default: 443 (HTTPS) or 80 when MCP_NO_TLS=true. Omit to use the default.
AUTH_MODE=token
# AUTH_MODE: oauth (OAuthProxy + DCR) or token (manual long-lived token)
DISCOVERY_MODE=static
# DISCOVERY_MODE: static (all 33 tools) | bm25 (search gateway) | code (CodeMode sandbox)
API_TOKEN_TTL=86400
# Legacy: CODE_MODE_EXPERIMENTAL=true forces DISCOVERY_MODE=code (overrides DISCOVERY_MODE)
HTTP_TIMEOUT=30
# HTTP_TIMEOUT: timeout (seconds) for TrueConf API HTTP requests. Default: 30.
#
# TLS:
MCP_NO_TLS=false
# MCP_NO_TLS=true — disable TLS (plain HTTP, default port 80).
MCP_TLS_CERT=
MCP_TLS_KEY=
# MCP_TLS_CERT / MCP_TLS_KEY — paths to a custom PEM cert+key. Both required if either is set.
# If omitted and TLS is enabled, a self-signed cert is generated and persisted
# in ~/Library/Application Support/fastmcp/tls/ (SAN from MCP_BASE_URL host).
